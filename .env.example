# Copy to .env (`make setup` does this) and fill in real values. Never commit .env.

# Directory containing the six *_verified.csv exports used as pipeline input.
RAW_DATA_DIR=~/Desktop/vinhomes-crawler/detect_human

# Gemini API key (https://aistudio.google.com/apikey). Billing-enabled key required for Batch API.
GEMINI_API_KEY=

# Hard cap on cumulative Gemini spend in USD across all pipeline steps; calls stop when reached.
GEMINI_BUDGET_USD=5

# Gemini model and pricing (USD per 1M tokens; output includes thinking tokens). Batch API calls
# are billed at GEMINI_BATCH_DISCOUNT of the online price. Update if Google changes prices.
# Temperature (default 0) and thinking level (default MINIMAL) are set per request in code.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_PRICE_INPUT_PER_M=0.30
GEMINI_PRICE_OUTPUT_PER_M=2.50
GEMINI_BATCH_DISCOUNT=0.5

# Root for pipeline outputs (git-ignored; relative paths resolve against the repo root).
# Gemini cache: $DATA_DIR/cache/gemini, usage log: $DATA_DIR/gemini_usage.parquet.
DATA_DIR=data

# Image/text embedding model: a Hugging Face repo with an FP16 ONNX export (switching needs no
# code change). Bake-off candidates: jinaai/jina-clip-v2 (CC-BY-NC-4.0, non-commercial),
# onnx-community/siglip2-base-patch16-256-ONNX, onnx-community/siglip2-so400m-patch16-384-ONNX
EMBED_MODEL=jinaai/jina-clip-v2

# Downloaded model weights (git-ignored; relative paths resolve against the repo root).
MODELS_DIR=models

# Timeout in milliseconds for Gemini calls made by the online query router.
LLM_TIMEOUT_MS=1200
